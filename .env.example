# Superuser/DBA — bootstrap + migrations only. Never deploy this to the app.
MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5432/saas

# Runtime app role (RLS enforced). The ONLY credential the web tier gets.
# The migration runner creates/updates this login role with this password.
APP_DATABASE_URL=postgres://app_user:change-me-app@localhost:5432/saas

# Back-office / support tooling (bypasses RLS). Keep off the web tier.
ADMIN_DATABASE_URL=postgres://admin_user:change-me-admin@localhost:5432/saas
